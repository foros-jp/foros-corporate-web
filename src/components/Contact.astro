<!-- Contact: Clean contact section with mailto CTA -->
<section id="contact" class="relative py-16 md:py-32 overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[1px] bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>

  <div class="max-w-4xl mx-auto px-5 sm:px-6">
    <div class="text-center anim">
      <span class="inline-block text-sm font-mono text-accent tracking-widest uppercase mb-4">Contact</span>
      <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-6">
        お気軽に<span class="gradient-text">ご相談ください</span>
      </h2>
      <p class="text-lg text-slate-400 max-w-xl mx-auto mb-12">
        業務改善・新規事業・システム開発など、お悩みがございましたらまずはお問い合わせください。
      </p>
    </div>

    <!-- Contact card -->
    <div class="card p-6 sm:p-10 md:p-14 text-center relative anim">
      <!-- Gradient border glow -->
      <div class="absolute -inset-[1px] rounded-[1rem] bg-gradient-to-r from-primary/20 via-accent/20 to-primary/20 -z-10 blur-sm"></div>

      <!-- Contact form -->
      <form id="contact-form" class="max-w-lg mx-auto space-y-6 mb-10 text-left">
        <div>
          <label for="name" class="block text-sm font-medium text-slate-300 mb-2">お名前</label>
          <input type="text" id="name" name="name" required
                 class="w-full px-4 py-3 rounded-lg bg-white/[0.04] border border-white/[0.08] text-slate-200 placeholder-slate-500 focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all" placeholder="山田 太郎"/>
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-300 mb-2">メールアドレス</label>
          <input type="email" id="email" name="email" required
                 class="w-full px-4 py-3 rounded-lg bg-white/[0.04] border border-white/[0.08] text-slate-200 placeholder-slate-500 focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all" placeholder="you@example.com"/>
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-slate-300 mb-2">お問い合わせ内容</label>
          <textarea id="message" name="message" rows="5" required
                    class="w-full px-4 py-3 rounded-lg bg-white/[0.04] border border-white/[0.08] text-slate-200 placeholder-slate-500 focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all resize-none" placeholder="ご相談内容をご記入ください"></textarea>
        </div>
        <button type="submit"
                class="w-full py-4 rounded-xl font-semibold text-white bg-gradient-to-r from-primary to-accent hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-0.5 transition-all duration-300">
          送信する
        </button>
      </form>

      <noscript>
        <p class="text-center text-slate-400 mt-4 mb-6">
          JavaScriptが無効です。<a href="mailto:info@foros.jp" class="text-primary hover:text-accent transition-colors">info@foros.jp</a>に直接メールをお送りください。
        </p>
      </noscript>

      <div class="h-[1px] bg-gradient-to-r from-transparent via-white/10 to-transparent mb-10"></div>

      <!-- Direct contact info -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-8">
        <a href="mailto:info@foros.jp" class="flex items-center gap-3 text-slate-300 hover:text-primary transition-colors group">
          <svg class="w-5 h-5 text-muted group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
          </svg>
          info@foros.jp
        </a>
        <span class="text-white/10 hidden sm:inline">|</span>
        <span class="flex items-center gap-3 text-slate-400">
          <svg class="w-5 h-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
          東京都杉並区高円寺南4-26-5 YSビル2F
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('name') as HTMLInputElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const message = (document.getElementById('message') as HTMLTextAreaElement).value;
    const subject = encodeURIComponent(`【Webサイトお問い合わせ】${name}様より`);
    const body = encodeURIComponent(`お名前: ${name}\nメール: ${email}\n\n${message}`);
    window.location.href = `mailto:info@foros.jp?subject=${subject}&body=${body}`;

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    if (btn) {
      btn.textContent = 'メールアプリが開きます';
      btn.classList.add('opacity-60', 'pointer-events-none');
      setTimeout(() => {
        btn.textContent = '送信する';
        btn.classList.remove('opacity-60', 'pointer-events-none');
      }, 3000);
    }
  });
</script>

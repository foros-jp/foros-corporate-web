---
const base = import.meta.env.BASE_URL;
---
<!-- Footer -->
<footer class="relative border-t border-white/[0.04] bg-surface-alt/30">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 py-12 md:py-16">
    <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-10 md:gap-12">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href={base} class="flex items-center gap-3 mb-5">
          <svg class="w-8 h-8" viewBox="0 0 40 40" fill="none">
            <rect x="2" y="2" width="36" height="36" rx="10" fill="url(#fg)" fill-opacity="0.15" stroke="url(#fg)" stroke-width="1.5"/>
            <path d="M14 12h14M14 12v18M14 20h10" stroke="url(#fg)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <defs>
              <linearGradient id="fg" x1="0" y1="0" x2="40" y2="40">
                <stop offset="0%" stop-color="#818cf8"/><stop offset="100%" stop-color="#22d3ee"/>
              </linearGradient>
            </defs>
          </svg>
          <span class="text-lg font-bold tracking-tight">FOROS</span>
        </a>
        <p class="text-sm text-slate-500 leading-relaxed max-w-sm mb-6">
          FOR Owner Side = FOROS<br/>
          経営者の立場に立ち、業務改革・新規事業をITで実現。<br/>
          計画策定から運用まで、ワンストップで支援します。
        </p>
        <p class="text-xs text-slate-600">〒166-0003 東京都杉並区高円寺南4-26-5 YSビル2F</p>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-sm font-semibold text-slate-300 mb-5 tracking-wide">Navigation</h4>
        <ul class="space-y-3">
          <li><a href={`${base}#services`} class="text-sm text-slate-500 hover:text-slate-200 transition-colors">Services</a></li>
          <li><a href={`${base}#product`} class="text-sm text-slate-500 hover:text-slate-200 transition-colors">Product</a></li>
          <li><a href={`${base}#stories`} class="text-sm text-slate-500 hover:text-slate-200 transition-colors">Our Stories</a></li>
          <li><a href={`${base}#about`} class="text-sm text-slate-500 hover:text-slate-200 transition-colors">About</a></li>
          <li><a href={`${base}#contact`} class="text-sm text-slate-500 hover:text-slate-200 transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-sm font-semibold text-slate-300 mb-5 tracking-wide">More</h4>
        <ul class="space-y-3">
          <li><a href={`${base}careers`} class="text-sm text-slate-500 hover:text-slate-200 transition-colors">Careers</a></li>
          <li><a href="https://sitrom.com" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-500 hover:text-slate-200 transition-colors">Sitrom-CC</a></li>
          <li><a href="mailto:info@foros.jp" class="text-sm text-slate-500 hover:text-slate-200 transition-colors">info@foros.jp</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-16 pt-8 border-t border-white/[0.04] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-600">&copy; {new Date().getFullYear()} FOROS株式会社 All rights reserved.</p>
      <p class="text-xs text-slate-700 font-mono">Accelerating Competitiveness.</p>
    </div>
  </div>
</footer>

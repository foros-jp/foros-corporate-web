<!-- Hero: Full-viewport with animated constellation background -->
<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden bg-white">
  <!-- Gradient orbs (parallax) -->
  <div data-parallax="-0.15" class="absolute top-1/4 -left-32 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[140px] animate-float pointer-events-none"></div>
  <div data-parallax="0.1" class="absolute bottom-1/4 -right-32 w-[420px] h-[420px] bg-accent/8 rounded-full blur-[120px] animate-float-delayed pointer-events-none"></div>

  <!-- Dot grid background -->
  <svg class="absolute inset-0 w-full h-full opacity-[0.06] pointer-events-none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="dot-grid" width="48" height="48" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="0.8" fill="#1B3A6B"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#dot-grid)"/>
  </svg>

  <!-- Animated constellation SVG -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <!-- Connection lines -->
    <g stroke-width="0.5" fill="none">
      <line x1="180" y1="120" x2="420" y2="280" stroke="#E8891A" stroke-opacity="0.1">
        <animate attributeName="stroke-opacity" values="0.1;0.2;0.1" dur="6s" repeatCount="indefinite"/>
      </line>
      <line x1="420" y1="280" x2="700" y2="180" stroke="#1B3A6B" stroke-opacity="0.08">
        <animate attributeName="stroke-opacity" values="0.08;0.16;0.08" dur="8s" repeatCount="indefinite"/>
      </line>
      <line x1="700" y1="180" x2="1050" y2="320" stroke="#E8891A" stroke-opacity="0.09">
        <animate attributeName="stroke-opacity" values="0.09;0.18;0.09" dur="7s" repeatCount="indefinite"/>
      </line>
      <line x1="1050" y1="320" x2="1280" y2="150" stroke="#1B3A6B" stroke-opacity="0.08">
        <animate attributeName="stroke-opacity" values="0.08;0.14;0.08" dur="9s" repeatCount="indefinite"/>
      </line>
      <line x1="300" y1="550" x2="600" y2="650" stroke="#E8891A" stroke-opacity="0.06">
        <animate attributeName="stroke-opacity" values="0.06;0.14;0.06" dur="10s" repeatCount="indefinite"/>
      </line>
      <line x1="600" y1="650" x2="900" y2="500" stroke="#1B3A6B" stroke-opacity="0.08">
        <animate attributeName="stroke-opacity" values="0.08;0.16;0.08" dur="7s" repeatCount="indefinite"/>
      </line>
      <line x1="900" y1="500" x2="1200" y2="620" stroke="#E8891A" stroke-opacity="0.06">
        <animate attributeName="stroke-opacity" values="0.06;0.12;0.06" dur="8s" repeatCount="indefinite"/>
      </line>
      <line x1="420" y1="280" x2="300" y2="550" stroke="#E8891A" stroke-opacity="0.05">
        <animate attributeName="stroke-opacity" values="0.05;0.12;0.05" dur="11s" repeatCount="indefinite"/>
      </line>
      <line x1="700" y1="180" x2="900" y2="500" stroke="#1B3A6B" stroke-opacity="0.05">
        <animate attributeName="stroke-opacity" values="0.05;0.1;0.05" dur="9s" repeatCount="indefinite"/>
      </line>
    </g>
    <!-- Nodes -->
    <g>
      <circle cx="180" cy="120" r="2.5" fill="#E8891A" opacity="0.5">
        <animate attributeName="cy" values="120;135;120" dur="7s" repeatCount="indefinite"/>
      </circle>
      <circle cx="420" cy="280" r="3" fill="#1B3A6B" opacity="0.4">
        <animate attributeName="cx" values="420;435;420" dur="9s" repeatCount="indefinite"/>
      </circle>
      <circle cx="700" cy="180" r="2" fill="#E8891A" opacity="0.5">
        <animate attributeName="cy" values="180;168;180" dur="8s" repeatCount="indefinite"/>
      </circle>
      <circle cx="1050" cy="320" r="2.5" fill="#1B3A6B" opacity="0.35">
        <animate attributeName="cx" values="1050;1065;1050" dur="10s" repeatCount="indefinite"/>
      </circle>
      <circle cx="1280" cy="150" r="2" fill="#E8891A" opacity="0.4">
        <animate attributeName="cy" values="150;140;150" dur="6s" repeatCount="indefinite"/>
      </circle>
      <circle cx="300" cy="550" r="2" fill="#1B3A6B" opacity="0.3">
        <animate attributeName="cx" values="300;315;300" dur="11s" repeatCount="indefinite"/>
      </circle>
      <circle cx="600" cy="650" r="2.5" fill="#E8891A" opacity="0.35">
        <animate attributeName="cy" values="650;640;650" dur="8s" repeatCount="indefinite"/>
      </circle>
      <circle cx="900" cy="500" r="3" fill="#1B3A6B" opacity="0.4">
        <animate attributeName="cx" values="900;912;900" dur="7s" repeatCount="indefinite"/>
      </circle>
      <circle cx="1200" cy="620" r="2" fill="#E8891A" opacity="0.3">
        <animate attributeName="cy" values="620;608;620" dur="9s" repeatCount="indefinite"/>
      </circle>
    </g>
  </svg>

  <!-- Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-5 sm:px-6 text-center">
    <!-- Logo -->
    <div class="mb-10 animate-fade-in">
      <img src={`${import.meta.env.BASE_URL}foros_logo_message.webp`} alt="FOROS - Accelerating Competitiveness." class="h-16 sm:h-20 md:h-24 mx-auto" width="656" height="176" fetchpriority="high" decoding="async" />
    </div>

    <!-- Mission -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] mb-7"
        style="animation: fade-in-up 0.9s ease-out 0.2s both;">
      <span class="text-accent">お客様の競争力を最大化し、</span><br/>
      <span class="text-accent">お客様と共に</span><span class="gradient-text">成長する</span>
    </h1>

    <!-- Sub -->
    <p class="text-lg md:text-xl text-gray-500 max-w-2xl mx-auto mb-12 leading-relaxed"
       style="animation: fade-in-up 0.9s ease-out 0.5s both;">
      Accelerating Competitiveness.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4"
         style="animation: fade-in-up 0.9s ease-out 0.8s both;">
      <a href="#services"
         class="cta-pulse group relative px-8 py-4 rounded-xl font-semibold text-white overflow-hidden transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/20">
        <span class="absolute inset-0 bg-gradient-to-r from-primary to-accent"></span>
        <span class="relative flex items-center gap-2">
          サービスを見る
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </span>
      </a>
      <a href="#contact"
         class="px-8 py-4 rounded-xl font-semibold text-gray-700 border border-gray-200 bg-white hover:bg-gray-50 hover:border-gray-300 transition-all duration-300">
        お問い合わせ
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2" style="animation: fade-in 1s ease-out 1.5s both;">
    <div class="w-6 h-10 rounded-full border-2 border-gray-300 flex justify-center pt-2">
      <div class="w-1 h-2.5 rounded-full bg-gray-400 animate-bounce"></div>
    </div>
  </div>
</section>

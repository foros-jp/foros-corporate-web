<!-- Product: Sitrom-CC showcase with animated dashboard SVG -->
<section id="product" class="relative py-16 md:py-32 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-surface-alt/50 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Text -->
      <div class="anim-left">
        <span class="inline-block text-sm font-mono text-primary tracking-widest uppercase mb-4">Product</span>
        <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-6">
          <span class="gradient-text">Sitrom-CC</span>
        </h2>
        <p class="text-xl text-gray-800 mb-4 font-medium">
          フルクラウド型原価管理・<br/>業務管理・管理会計サービス
        </p>
        <p class="text-gray-600 leading-relaxed mb-8">
          工事別の原価管理から、部門別・プロジェクト別の管理会計まで。
          リアルタイムでデータを可視化し、経営判断をサポートするクラウド統合システムです。
        </p>
        <a href="https://sitrom.com" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-primary/30 text-primary font-semibold hover:bg-primary/5 hover:border-primary/50 transition-all duration-300 group">
          詳しく見る
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/>
          </svg>
        </a>
      </div>

      <!-- Animated Dashboard SVG -->
      <div class="anim-right relative">
        <div class="relative rounded-2xl overflow-hidden border border-gray-200 bg-white p-6 shadow-lg shadow-gray-200/50">
          <svg class="w-full" viewBox="0 0 500 320" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Dashboard frame -->
            <rect x="0" y="0" width="500" height="320" rx="12" fill="#f8f9fc"/>

            <!-- Top bar -->
            <rect x="16" y="12" width="468" height="36" rx="6" fill="white"/>
            <circle cx="32" cy="30" r="5" fill="#ef4444" opacity="0.6"/>
            <circle cx="48" cy="30" r="5" fill="#f59e0b" opacity="0.6"/>
            <circle cx="64" cy="30" r="5" fill="#22c55e" opacity="0.6"/>
            <text x="250" y="34" text-anchor="middle" fill="#94a3b8" font-size="10" font-family="Inter">Sitrom-CC Dashboard</text>

            <!-- Chart area -->
            <rect x="16" y="60" width="228" height="140" rx="8" fill="white" stroke="#e5e7eb" stroke-width="1"/>
            <text x="28" y="80" fill="#94a3b8" font-size="9" font-family="Inter">工事原価推移</text>

            <!-- Animated bars -->
            <g>
              <rect x="36" y="160" width="24" height="0" rx="3" fill="#E8891A" opacity="0.7">
                <animate attributeName="height" from="0" to="60" dur="1.2s" begin="0.5s" fill="freeze"/>
                <animate attributeName="y" from="160" to="100" dur="1.2s" begin="0.5s" fill="freeze"/>
              </rect>
              <rect x="68" y="160" width="24" height="0" rx="3" fill="#E8891A" opacity="0.8">
                <animate attributeName="height" from="0" to="80" dur="1.2s" begin="0.7s" fill="freeze"/>
                <animate attributeName="y" from="160" to="80" dur="1.2s" begin="0.7s" fill="freeze"/>
              </rect>
              <rect x="100" y="160" width="24" height="0" rx="3" fill="#1B3A6B" opacity="0.7">
                <animate attributeName="height" from="0" to="50" dur="1.2s" begin="0.9s" fill="freeze"/>
                <animate attributeName="y" from="160" to="110" dur="1.2s" begin="0.9s" fill="freeze"/>
              </rect>
              <rect x="132" y="160" width="24" height="0" rx="3" fill="#1B3A6B" opacity="0.8">
                <animate attributeName="height" from="0" to="90" dur="1.2s" begin="1.1s" fill="freeze"/>
                <animate attributeName="y" from="160" to="70" dur="1.2s" begin="1.1s" fill="freeze"/>
              </rect>
              <rect x="164" y="160" width="24" height="0" rx="3" fill="#E8891A" opacity="0.9">
                <animate attributeName="height" from="0" to="70" dur="1.2s" begin="1.3s" fill="freeze"/>
                <animate attributeName="y" from="160" to="90" dur="1.2s" begin="1.3s" fill="freeze"/>
              </rect>
              <rect x="196" y="160" width="24" height="0" rx="3" fill="#059669" opacity="0.8">
                <animate attributeName="height" from="0" to="95" dur="1.2s" begin="1.5s" fill="freeze"/>
                <animate attributeName="y" from="160" to="65" dur="1.2s" begin="1.5s" fill="freeze"/>
              </rect>
            </g>

            <!-- KPI cards -->
            <rect x="256" y="60" width="228" height="64" rx="8" fill="white" stroke="#e5e7eb" stroke-width="1"/>
            <text x="268" y="80" fill="#94a3b8" font-size="9" font-family="Inter">粗利率</text>
            <text x="268" y="105" fill="#059669" font-size="22" font-weight="700" font-family="Inter">
              <animate attributeName="opacity" from="0" to="1" dur="0.5s" begin="1s" fill="freeze"/>
              32.4%
            </text>
            <text x="350" y="105" fill="#059669" font-size="10" font-family="Inter" opacity="0.7">+4.2%</text>

            <rect x="256" y="136" width="228" height="64" rx="8" fill="white" stroke="#e5e7eb" stroke-width="1"/>
            <text x="268" y="156" fill="#94a3b8" font-size="9" font-family="Inter">進行プロジェクト</text>
            <text x="268" y="181" fill="#E8891A" font-size="22" font-weight="700" font-family="Inter">
              <animate attributeName="opacity" from="0" to="1" dur="0.5s" begin="1.3s" fill="freeze"/>
              128件
            </text>

            <!-- Line chart area -->
            <rect x="16" y="212" width="468" height="96" rx="8" fill="white" stroke="#e5e7eb" stroke-width="1"/>
            <text x="28" y="232" fill="#94a3b8" font-size="9" font-family="Inter">月次売上推移</text>
            <polyline points="36,290 80,275 130,280 180,260 230,250 280,255 330,235 380,220 430,225 465,210"
                      stroke="#E8891A" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"
                      stroke-dasharray="500" stroke-dashoffset="500">
              <animate attributeName="stroke-dashoffset" from="500" to="0" dur="2s" begin="0.8s" fill="freeze"/>
            </polyline>
            <polyline points="36,290 80,275 130,280 180,260 230,250 280,255 330,235 380,220 430,225 465,210"
                      stroke="url(#area-grad)" stroke-width="0" fill="url(#area-grad)" opacity="0">
              <animate attributeName="opacity" from="0" to="0.15" dur="1s" begin="2.5s" fill="freeze"/>
            </polyline>

            <defs>
              <linearGradient id="area-grad" x1="250" y1="210" x2="250" y2="290" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#E8891A"/>
                <stop offset="100%" stop-color="#E8891A" stop-opacity="0"/>
              </linearGradient>
            </defs>
          </svg>
        </div>

        <!-- Floating badges -->
        <div class="absolute -top-4 right-2 sm:-right-4 px-4 py-2 rounded-lg glass text-xs font-mono text-emerald animate-float">
          Cloud-Native
        </div>
        <div class="absolute -bottom-4 left-2 sm:-left-4 px-4 py-2 rounded-lg glass text-xs font-mono text-primary animate-float-delayed">
          Real-time Analytics
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Services: Bento grid with animated SVG icons -->
<section id="services" class="relative py-32 overflow-hidden">
  <!-- Background accent -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[1px] bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-20 anim">
      <span class="inline-block text-sm font-mono text-primary tracking-widest uppercase mb-4">Services</span>
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6">
        ワンストップで<span class="gradient-text">課題を解決</span>
      </h2>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto">
        既定メニューやパッケージを売るのではなく、業務構想から運用までを一貫して支援。<br class="hidden md:block"/>
        20年以上の実績で、困難な課題を最短距離で解決します。
      </p>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-3 gap-6 stagger relative">
      <!-- Step connector line (desktop only) -->
      <div class="hidden md:block absolute top-[3.5rem] left-[calc(33.33%+0.75rem)] right-[calc(33.33%+0.75rem)] h-[1px] bg-gradient-to-r from-primary/30 via-accent/30 to-primary/30 z-10 pointer-events-none"></div>
      <!-- Analysis -->
      <div class="card card-glow group anim">
        <div class="mb-6">
          <svg class="w-14 h-14 svg-draw" viewBox="0 0 56 56" fill="none" stroke-width="1.5">
            <circle cx="28" cy="28" r="24" stroke="#818cf8" stroke-opacity="0.2"/>
            <circle cx="24" cy="24" r="10" stroke="#818cf8"/>
            <line x1="31" y1="31" x2="42" y2="42" stroke="#22d3ee" stroke-linecap="round"/>
            <circle cx="24" cy="24" r="3" stroke="#818cf8" stroke-opacity="0.5"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-3 group-hover:text-primary transition-colors">Analysis</h3>
        <p class="text-slate-400 leading-relaxed">
          データフロー解析によりビジネスのボトルネックを抽出。定量的なアプローチで課題の本質を明らかにします。
        </p>
        <div class="mt-6 pt-6 border-t border-white/[0.04]">
          <span class="text-sm font-mono text-muted">データ解析・業務分析・KPI設計</span>
        </div>
      </div>

      <!-- Planning -->
      <div class="card card-glow group anim">
        <div class="mb-6">
          <svg class="w-14 h-14 svg-draw" viewBox="0 0 56 56" fill="none" stroke-width="1.5">
            <circle cx="28" cy="28" r="24" stroke="#818cf8" stroke-opacity="0.2"/>
            <rect x="16" y="16" width="24" height="24" rx="3" stroke="#818cf8"/>
            <line x1="16" y1="24" x2="40" y2="24" stroke="#22d3ee"/>
            <line x1="28" y1="24" x2="28" y2="40" stroke="#818cf8" stroke-opacity="0.5"/>
            <circle cx="22" cy="32" r="2" stroke="#22d3ee"/>
            <circle cx="34" cy="34" r="2" stroke="#818cf8"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-3 group-hover:text-primary transition-colors">Planning</h3>
        <p class="text-slate-400 leading-relaxed">
          新業務・システムの構想設計。最適なアーキテクチャとロードマップを策定し、実現可能な計画を立案します。
        </p>
        <div class="mt-6 pt-6 border-t border-white/[0.04]">
          <span class="text-sm font-mono text-muted">構想設計・要件定義・ロードマップ</span>
        </div>
      </div>

      <!-- Execution -->
      <div class="card card-glow group anim">
        <div class="mb-6">
          <svg class="w-14 h-14 svg-draw" viewBox="0 0 56 56" fill="none" stroke-width="1.5">
            <circle cx="28" cy="28" r="24" stroke="#818cf8" stroke-opacity="0.2"/>
            <path d="M20 36l6-8 6 5 8-13" stroke="#22d3ee" stroke-linecap="round" stroke-linejoin="round"/>
            <polyline points="35,20 40,20 40,25" stroke="#818cf8" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="16" y1="40" x2="40" y2="40" stroke="#818cf8" stroke-opacity="0.3"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-3 group-hover:text-primary transition-colors">Execution</h3>
        <p class="text-slate-400 leading-relaxed">
          情報技術を活用したシステム実装とプロジェクト管理。計画を確実に遂行し、運用まで伴走します。
        </p>
        <div class="mt-6 pt-6 border-t border-white/[0.04]">
          <span class="text-sm font-mono text-muted">開発・PM・導入・運用保守</span>
        </div>
      </div>
    </div>
  </div>
</section>

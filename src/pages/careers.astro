---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="採用情報 | フォロス株式会社"
  description="フォロス株式会社の採用情報。AI-Nativeな環境で、次の時代を創るディレクター・プロジェクトマネージャー・エンジニアを募集しています。"
>
  <Header currentPage="careers" />

  <main id="main-content">
    <!-- Hero -->
    <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden pt-20">
      <!-- Background -->
      <div class="absolute top-1/3 left-1/4 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[160px] animate-float pointer-events-none"></div>
      <div class="absolute bottom-1/4 right-1/3 w-[400px] h-[400px] bg-accent/8 rounded-full blur-[140px] animate-float-delayed pointer-events-none"></div>

      <!-- Neural network SVG -->
      <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.06]" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice">
        <!-- Layer 1 (input) -->
        <g>
          <circle cx="200" cy="200" r="6" fill="#E8891A">
            <animate attributeName="r" values="6;8;6" dur="4s" repeatCount="indefinite"/>
          </circle>
          <circle cx="200" cy="350" r="6" fill="#E8891A">
            <animate attributeName="r" values="6;7;6" dur="5s" repeatCount="indefinite"/>
          </circle>
          <circle cx="200" cy="500" r="6" fill="#E8891A">
            <animate attributeName="r" values="6;8;6" dur="4.5s" repeatCount="indefinite"/>
          </circle>
          <circle cx="200" cy="650" r="6" fill="#E8891A">
            <animate attributeName="r" values="6;7;6" dur="3.5s" repeatCount="indefinite"/>
          </circle>
        </g>
        <!-- Layer 2 (hidden) -->
        <g>
          <circle cx="520" cy="250" r="5" fill="#1B3A6B">
            <animate attributeName="r" values="5;7;5" dur="4.2s" repeatCount="indefinite"/>
          </circle>
          <circle cx="520" cy="400" r="5" fill="#1B3A6B">
            <animate attributeName="r" values="5;7;5" dur="3.8s" repeatCount="indefinite"/>
          </circle>
          <circle cx="520" cy="550" r="5" fill="#1B3A6B">
            <animate attributeName="r" values="5;6;5" dur="5s" repeatCount="indefinite"/>
          </circle>
        </g>
        <!-- Layer 3 (hidden) -->
        <g>
          <circle cx="840" cy="300" r="5" fill="#E8891A">
            <animate attributeName="r" values="5;7;5" dur="3.5s" repeatCount="indefinite"/>
          </circle>
          <circle cx="840" cy="450" r="5" fill="#E8891A">
            <animate attributeName="r" values="5;6;5" dur="4.5s" repeatCount="indefinite"/>
          </circle>
          <circle cx="840" cy="600" r="5" fill="#E8891A">
            <animate attributeName="r" values="5;7;5" dur="4s" repeatCount="indefinite"/>
          </circle>
        </g>
        <!-- Layer 4 (output) -->
        <g>
          <circle cx="1160" cy="350" r="6" fill="#059669">
            <animate attributeName="r" values="6;8;6" dur="4s" repeatCount="indefinite"/>
          </circle>
          <circle cx="1160" cy="500" r="6" fill="#059669">
            <animate attributeName="r" values="6;8;6" dur="5s" repeatCount="indefinite"/>
          </circle>
        </g>
        <!-- Connections L1 → L2 -->
        <g stroke-width="0.8" opacity="0.4">
          <line x1="200" y1="200" x2="520" y2="250" stroke="#E8891A" stroke-opacity="0.15"/>
          <line x1="200" y1="200" x2="520" y2="400" stroke="#E8891A" stroke-opacity="0.1"/>
          <line x1="200" y1="350" x2="520" y2="250" stroke="#E8891A" stroke-opacity="0.1"/>
          <line x1="200" y1="350" x2="520" y2="400" stroke="#E8891A" stroke-opacity="0.15"/>
          <line x1="200" y1="500" x2="520" y2="400" stroke="#E8891A" stroke-opacity="0.1"/>
          <line x1="200" y1="500" x2="520" y2="550" stroke="#E8891A" stroke-opacity="0.15"/>
          <line x1="200" y1="650" x2="520" y2="550" stroke="#E8891A" stroke-opacity="0.15"/>
          <line x1="200" y1="650" x2="520" y2="400" stroke="#E8891A" stroke-opacity="0.08"/>
        </g>
        <!-- Connections L2 → L3 -->
        <g stroke-width="0.8" opacity="0.4">
          <line x1="520" y1="250" x2="840" y2="300" stroke="#1B3A6B" stroke-opacity="0.12"/>
          <line x1="520" y1="250" x2="840" y2="450" stroke="#1B3A6B" stroke-opacity="0.08"/>
          <line x1="520" y1="400" x2="840" y2="300" stroke="#1B3A6B" stroke-opacity="0.1"/>
          <line x1="520" y1="400" x2="840" y2="450" stroke="#1B3A6B" stroke-opacity="0.12"/>
          <line x1="520" y1="400" x2="840" y2="600" stroke="#1B3A6B" stroke-opacity="0.08"/>
          <line x1="520" y1="550" x2="840" y2="450" stroke="#1B3A6B" stroke-opacity="0.1"/>
          <line x1="520" y1="550" x2="840" y2="600" stroke="#1B3A6B" stroke-opacity="0.12"/>
        </g>
        <!-- Connections L3 → L4 -->
        <g stroke-width="0.8" opacity="0.4">
          <line x1="840" y1="300" x2="1160" y2="350" stroke="#059669" stroke-opacity="0.15"/>
          <line x1="840" y1="300" x2="1160" y2="500" stroke="#059669" stroke-opacity="0.08"/>
          <line x1="840" y1="450" x2="1160" y2="350" stroke="#059669" stroke-opacity="0.1"/>
          <line x1="840" y1="450" x2="1160" y2="500" stroke="#059669" stroke-opacity="0.12"/>
          <line x1="840" y1="600" x2="1160" y2="500" stroke="#059669" stroke-opacity="0.15"/>
          <line x1="840" y1="600" x2="1160" y2="350" stroke="#059669" stroke-opacity="0.08"/>
        </g>
      </svg>

      <div class="relative z-10 max-w-4xl mx-auto px-5 sm:px-6 text-center">
        <div class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full border border-gray-200 bg-white/80 mb-8 animate-fade-in">
          <span class="w-2 h-2 rounded-full bg-emerald animate-pulse"></span>
          <span class="text-sm font-mono text-muted tracking-wide">Now Hiring</span>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-[-0.03em] leading-[1.08] mb-7"
            style="animation: fade-in-up 0.9s ease-out 0.2s both;">
          <span class="text-accent">AI-Nativeな環境で、</span><br/>
          <span class="gradient-text">未来を創りませんか？</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed"
           style="animation: fade-in-up 0.9s ease-out 0.5s both;">
          最先端のAIツールを日常的に活用し、テクノロジーで経営課題を解決する。<br class="hidden md:block"/>
          FOROSで、あなたのキャリアを加速させましょう。
        </p>

        <!-- Hero CTA -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10"
             style="animation: fade-in-up 0.9s ease-out 0.8s both;">
          <a href="#open-positions"
             class="group relative px-8 py-4 rounded-xl font-semibold text-white overflow-hidden transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/20">
            <span class="absolute inset-0 bg-gradient-to-r from-primary to-accent"></span>
            <span class="relative flex items-center gap-2">
              募集職種を見る
              <svg class="w-4 h-4 transition-transform group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- Why FOROS -->
    <section class="py-16 md:py-32">
      <div class="max-w-7xl mx-auto px-5 sm:px-6">
        <div class="text-center mb-12 md:mb-20 anim">
          <span class="inline-block text-sm font-mono text-primary tracking-widest uppercase mb-4">Why FOROS</span>
          <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-6 text-accent">
            FOROSで<span class="gradient-text">働く理由</span>
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6 stagger">
          <!-- AI-First Culture -->
          <div class="card card-glow group anim">
            <div class="flex items-start gap-5">
              <div class="shrink-0 w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2 text-accent group-hover:text-primary transition-colors">AI-First Culture</h3>
                <p class="text-gray-600 leading-relaxed">
                  Claude Code、GitHub Copilot、ChatGPTをはじめとする最新AIツールを業務全体で積極活用。
                  AI-Nativeなワークフローで、一人ひとりの生産性を最大化します。
                </p>
              </div>
            </div>
          </div>

          <!-- Growth -->
          <div class="card card-glow group anim">
            <div class="flex items-start gap-5">
              <div class="shrink-0 w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2 text-accent group-hover:text-primary transition-colors">圧倒的な成長環境</h3>
                <p class="text-gray-600 leading-relaxed">
                  経営者に近い立場でプロジェクトに参画。コンサルティングから実装まで一貫して携わることで、
                  市場価値の高いスキルセットを短期間で獲得できます。
                </p>
              </div>
            </div>
          </div>

          <!-- Impact -->
          <div class="card card-glow group anim">
            <div class="flex items-start gap-5">
              <div class="shrink-0 w-12 h-12 rounded-xl bg-emerald/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2 text-accent group-hover:text-emerald transition-colors">20年以上の実績</h3>
                <p class="text-gray-600 leading-relaxed">
                  2002年の創業以来、多業界で培った豊富な知見とクライアントネットワーク。
                  確かな基盤の上で、最先端技術にチャレンジできる環境があります。
                </p>
              </div>
            </div>
          </div>

          <!-- Technology -->
          <div class="card card-glow group anim">
            <div class="flex items-start gap-5">
              <div class="shrink-0 w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2 text-accent group-hover:text-primary transition-colors">最新テクノロジースタック</h3>
                <p class="text-gray-600 leading-relaxed">
                  クラウドネイティブ、AI/ML、ブロックチェーンなど最先端技術を積極採用。
                  技術的な挑戦を楽しみながら、社会にインパクトを与えるプロダクトを開発します。
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Open Positions -->
    <section id="open-positions" class="py-16 md:py-32 relative">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-surface-alt/40 to-transparent pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-5 sm:px-6 relative">
        <div class="text-center mb-12 md:mb-20 anim">
          <span class="inline-block text-sm font-mono text-primary tracking-widest uppercase mb-4">Open Positions</span>
          <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-6 text-accent">
            <span class="gradient-text">募集職種</span>
          </h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            AIのトレンドに敏感で、テクノロジーで経営課題を解決したい仲間を探しています。
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-6 stagger">
          <!-- Director -->
          <div class="card card-glow group anim flex flex-col">
            <div class="mb-6">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-mono bg-primary/10 text-primary border border-primary/20 mb-4">Director</span>
              <h3 class="text-2xl font-bold text-accent group-hover:text-primary transition-colors">ITディレクター</h3>
            </div>
            <p class="text-gray-600 leading-relaxed mb-6 flex-1">
              クライアントの経営課題をヒアリングし、IT戦略の全体像を設計。
              プロジェクトの方向性を定め、チームを率いて成果にコミットするポジションです。
            </p>
            <div class="space-y-3 mb-8">
              <h4 class="text-sm font-semibold text-gray-700">求めるスキル</h4>
              <ul class="space-y-2 text-sm text-gray-600">
                <li class="flex items-start gap-2">
                  <span class="w-1 h-1 rounded-full bg-primary mt-2 shrink-0"></span>
                  IT戦略立案・業務コンサルティング経験
                </li>
                <li class="flex items-start gap-2">
                  <span class="w-1 h-1 rounded-full bg-primary mt-2 shrink-0"></span>
                  経営層との折衝・提案能力
                </li>
                <li class="flex items-start gap-2">
                  <span class="w-1 h-1 rounded-full bg-primary mt-2 shrink-0"></span>
                  AI/DXトレンドへの高い関心
                </li>
              </ul>
            </div>
            <a href="mailto:info@foros.jp?subject=ITディレクター職への応募"
               class="inline-flex items-center justify-center gap-2 w-full py-3 rounded-xl border border-primary/30 text-primary font-semibold hover:bg-primary/5 hover:border-primary/50 transition-all duration-300 group/btn">
              応募する
              <svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
              </svg>
            </a>
          </div>

          <!-- PM -->
          <div class="card card-glow group anim flex flex-col">
            <div class="mb-6">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-mono bg-accent/10 text-accent border border-accent/20 mb-4">Project Manager</span>
              <h3 class="text-2xl font-bold text-accent group-hover:text-primary transition-colors">プロジェクトマネージャー</h3>
            </div>
            <p class="text-gray-600 leading-relaxed mb-6 flex-1">
              複数プロジェクトの進行管理とチームマネジメント。
              AIツールを活用した効率的なPM手法で、クライアントの期待を超える成果を実現します。
            </p>
            <div class="space-y-3 mb-8">
              <h4 class="text-sm font-semibold text-gray-700">求めるスキル</h4>
              <ul class="space-y-2 text-sm text-gray-600">
                <li class="flex items-start gap-2">
                  <span class="w-1 h-1 rounded-full bg-accent mt-2 shrink-0"></span>
                  システム開発プロジェクトのPM経験
                </li>
                <li class="flex items-start gap-2">
                  <span class="w-1 h-1 rounded-full bg-accent mt-2 shrink-0"></span>
                  要件定義・設計の実務経験
                </li>
                <li class="flex items-start gap-2">
                  <span class="w-1 h-1 rounded-full bg-accent mt-2 shrink-0"></span>
                  AI活用による業務効率化への意欲
                </li>
              </ul>
            </div>
            <a href="mailto:info@foros.jp?subject=プロジェクトマネージャー職への応募"
               class="inline-flex items-center justify-center gap-2 w-full py-3 rounded-xl border border-accent/30 text-accent font-semibold hover:bg-accent/5 hover:border-accent/50 transition-all duration-300 group/btn">
              応募する
              <svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
              </svg>
            </a>
          </div>

          <!-- Engineer -->
          <div class="card card-glow group anim flex flex-col">
            <div class="mb-6">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-mono bg-emerald/10 text-emerald border border-emerald/20 mb-4">Engineer</span>
              <h3 class="text-2xl font-bold text-accent group-hover:text-emerald transition-colors">ソフトウェアエンジニア</h3>
            </div>
            <p class="text-gray-600 leading-relaxed mb-6 flex-1">
              クラウドシステムの設計・開発からAI/ML実装まで。
              Claude CodeやCopilotを駆使し、最小のコードで最大のインパクトを生み出すエンジニアを求めています。
            </p>
            <div class="space-y-3 mb-8">
              <h4 class="text-sm font-semibold text-gray-700">求めるスキル</h4>
              <ul class="space-y-2 text-sm text-gray-600">
                <li class="flex items-start gap-2">
                  <span class="w-1 h-1 rounded-full bg-emerald mt-2 shrink-0"></span>
                  Webアプリケーション開発経験
                </li>
                <li class="flex items-start gap-2">
                  <span class="w-1 h-1 rounded-full bg-emerald mt-2 shrink-0"></span>
                  クラウドインフラ（AWS/GCP等）の知識
                </li>
                <li class="flex items-start gap-2">
                  <span class="w-1 h-1 rounded-full bg-emerald mt-2 shrink-0"></span>
                  AIコーディングツールの実務活用経験
                </li>
              </ul>
            </div>
            <a href="mailto:info@foros.jp?subject=ソフトウェアエンジニア職への応募"
               class="inline-flex items-center justify-center gap-2 w-full py-3 rounded-xl border border-emerald/30 text-emerald font-semibold hover:bg-emerald/5 hover:border-emerald/50 transition-all duration-300 group/btn">
              応募する
              <svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 md:py-32">
      <div class="max-w-3xl mx-auto px-5 sm:px-6 text-center anim">
        <div class="card p-12 md:p-16 relative">
          <div class="absolute -inset-[1px] rounded-[1rem] bg-gradient-to-r from-primary/20 via-accent/20 to-emerald/20 -z-10 blur-sm"></div>

          <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-6 text-accent">
            一緒に<span class="gradient-text">未来を創りましょう</span>
          </h2>
          <p class="text-gray-600 leading-relaxed mb-10 max-w-lg mx-auto">
            まずはカジュアルにお話ししませんか？<br/>
            経験・スキルに関わらず、AIとテクノロジーに情熱を持つ方からのご連絡をお待ちしています。
          </p>
          <a href="mailto:info@foros.jp?subject=採用に関するお問い合わせ"
             class="inline-flex items-center gap-2 px-8 py-4 rounded-xl font-semibold text-white bg-gradient-to-r from-primary to-accent hover:shadow-xl hover:shadow-primary/20 hover:-translate-y-0.5 transition-all duration-300 group">
            お問い合わせ
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
            </svg>
          </a>
          <p class="mt-6 text-sm text-muted">
            <a href="mailto:info@foros.jp" class="text-primary hover:text-accent transition-colors">info@foros.jp</a>
            までお気軽にご連絡ください
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- JobPosting structured data for SEO -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify([
      {
